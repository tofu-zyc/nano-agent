  {
    "type": "function",
    "function": {
      "name": "Report",
      "description": "向主人汇报这件事现在的情况；汇报的是哪件事由系统从这一轮推出（自己安排的检查不对应任何承诺，不能汇报）。只告诉主人情况，不改变这件事本身的状态：做完日程仍用 Agenda done。一轮最多汇报 4 次。",
      "parameters": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "progress",
              "waiting",
              "ready",
              "blocked",
              "failed",
              "not_needed"
            ],
            "description": "ready 有结果可用（要带 evidence）；blocked 卡住了、要人处理；failed 做不下去了；not_needed 不用做了；progress、waiting 只记一笔，不会发给任何人"
          },
          "text": {
            "type": "string",
            "description": "说明，最多 500 字；blocked、failed、not_needed 必须写"
          },
          "question": {
            "type": "string",
            "description": "要主人回答的一个具体问题，最多 200 字，只能和 blocked 一起用；定时任务和 Hook 这一轮结束后没有人接着问，不能带"
          },
          "evidence": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "ready 必填：从工具结果开头 [本轮验收凭据] 复制 id，必须是本轮真实成功的工具结果"
          }
        },
        "required": [
          "status"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "SendFile",
      "description": "把图片、表情包、动图、音频、视频或文件发到当前聊天，对方直接收到（不是发链接）。files 每项是工作目录里的文件路径（相对路径从工作目录开始），或者 http(s) 网址。想发表情包、图片就用它，别在回复里用文字描述图片。要配一句话就在调用之前或之后照常回复。单个文件最多 20 MB。",
      "parameters": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "要发的文件：路径或网址，按顺序发"
          },
          "workspace": {
            "type": "string",
            "description": "文件在哪个工作目录（挂了好几个时写）"
          }
        },
        "required": [
          "files"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "Session",
      "description": "在会话之间分叉（Fork）：把一个会话在某个安全边界上的上下文保存成不可变快照，分支带着这份上下文独立继续，源会话照常用；分支默认安静运行，结果不发回原来的聊天。action 取 fork / list_branches / inspect / continue / pause / archive。在工具批次里调用 fork 会先返回 pending_boundary，等这批调用结束才真正建好；用同一个 request_id 重试返回同一个分支。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "fork",
              "list_branches",
              "inspect",
              "continue",
              "pause",
              "archive"
            ],
            "description": "要做的事，默认 fork"
          },
          "source_sid": {
            "type": "string",
            "description": "从哪个会话分叉，默认当前会话"
          },
          "branch_sid": {
            "type": "string",
            "description": "inspect / continue / pause / archive 要操作的分支"
          },
          "title": {
            "type": "string",
            "description": "分支标题"
          },
          "prompt": {
            "type": "string",
            "description": "start=true 或 continue 时，这一轮要在分支里做什么"
          },
          "start": {
            "type": "boolean",
            "description": "建完就在分支里开始跑"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "silent"
            ],
            "description": "结果留在分支里；只有用户显式操作可以开启报告"
          },
          "request_id": {
            "type": "string",
            "description": "幂等键：同一个 request_id 重试返回同一个分支"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  },
