  {
    "type": "function",
    "function": {
      "name": "Message",
      "description": "给网关里的一个群（房间）、某个 agent，或者你自己的某个私聊（chat:）发一条消息；发给 agent 时把 wait 设成 true 可以等对方回话（最多 5 分钟）。群里的成员都看得到，对方是那个一直在的 agent，不是临时开出来的。发到私聊的消息对方会在聊天软件里收到，他回了就在那个聊天里接着聊。给 chat:\u003c自己的 life 会话\u003e 留言不会发给任何人，只是放进它的内心。",
      "parameters": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "发给谁：room:\u003c群名或 ID\u003e 发到群里，agent:\u003c名字或 ID\u003e 私聊某个 agent，chat:\u003c会话 ID\u003e 发到你自己的某个私聊（比如 chat:main 是主人）；也可以只写名字"
          },
          "text": {
            "type": "string",
            "description": "要说的内容"
          },
          "wait": {
            "type": "boolean",
            "description": "等对方回话再返回（最多 5 分钟），默认 false"
          }
        },
        "required": [
          "to",
          "text"
        ]
      }
    }
  },
