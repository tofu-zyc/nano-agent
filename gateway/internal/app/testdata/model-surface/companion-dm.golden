          "reason": {
            "type": "string",
            "description": "invalidate：为什么过时了（比如换了新工作，见哪一条）"
          },
          "type_filter": {
            "type": "string",
            "description": "search：只搜这个类型"
          },
          "person": {
            "type": "string",
            "description": "search：只要跟这个人有关的"
          },
          "include_invalid": {
            "type": "boolean",
            "description": "search：连过时的也搜"
          },
          "who": {
            "type": "string",
            "description": "person：按身份找"
          },
          "name": {
            "type": "string",
            "description": "person：按名字找"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "Message",
      "description": "给网关里的一个群（房间）、某个 agent，或者你自己的某个私聊（chat:）发一条消息；发给 agent 时把 wait 设成 true 可以等对方回话（最多 5 分钟）。群里的成员都看得到，对方是那个一直在的 agent，不是临时开出来的。发到私聊的消息对方会在聊天软件里收到，他回了就在那个聊天里接着聊。给 chat:\u003c自己的 life 会话\u003e 留言不会发给任何人，只是放进它的内心。",
      "parameters": {
        "type": "object",
        "properties": {
          "to": {
            "type": "string",
            "description": "发给谁：room:\u003c群名或 ID\u003e 发到群里，agent:\u003c名字或 ID\u003e 私聊某个 agent，chat:\u003c会话 ID\u003e 发到你自己的某个私聊（比如 chat:main 是主人）；也可以只写名字"
          },
          "text": {
            "type": "string",
            "description": "要说的内容"
          },
          "wait": {
            "type": "boolean",
            "description": "等对方回话再返回（最多 5 分钟），默认 false"
          }
        },
        "required": [
          "to",
          "text"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "Mind",
      "description": "管理你跨轮次的心智状态：长期兴趣、对人和事的认识、反思。兴趣和认识必须写来源；它们会一直留着，下次醒来还能看到。先 view 看现在有什么。不要用它改人格或权限。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "view",
              "interest_add",
              "interest_remove",
              "belief",
              "reflect",
              "dimension"
            ]
          },
          "text": {
            "type": "string",
            "description": "interest_add：兴趣内容；interest_remove：要删掉的兴趣原文；reflect：这次反思"
          },
          "source": {
            "type": "string",
            "description": "interest_add / belief：来源，写清从哪次经历、哪段聊天或哪次反思来的（必填）"
          },
          "subject": {
            "type": "string",
            "description": "belief：这条认识是关于什么的（比如某个人、某件事）；dimension：维度名（curiosity / social_drive / focus / energy）"
          },
          "value": {
            "type": "string",
            "description": "belief：你认为它是怎样的"
          },
          "confidence": {
            "type": "number",
            "description": "belief：置信度 0–1，默认 0.6；dimension：这次想调多少（-max_delta_per_run..max_delta_per_run，每轮累计有上限）"
          },
          "change": {
            "type": "string",
            "description": "reflect：这次反思之后打算怎么调整"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "Schedule",
      "description": "管理定时任务（仅管理员）：create/list/update/delete/run_now。创建、修改、删除遵循当前权限模式。任务独立会话运行；结果默认只放在任务页，想让谁看到就把 deliver 写成那个窗口。先列出再按 id 修改，回答中说明运行时间和投递位置。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "create",
              "list",
              "update",
              "delete",
              "run_now"
            ]
          },
          "id": {
            "type": "string",
            "description": "任务编号（更新、删除、立即运行时必填）"
          },
          "name": {
            "type": "string"
          },
          "when": {
            "type": "string",
            "description": "cron 五段式、every 30m、at YYYY-MM-DD HH:mm；网关时区"
          },
          "agent": {
            "type": "string",
            "description": "任务归哪个 agent；省略就是当前会话的执行 agent。已有任务不会被聊天里的切换改动"
          },
          "prompt": {
            "type": "string"
          },
          "deliver": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "把结果投到哪些窗口（会话的窗口 key，网页用 web:会话ID）；省略就只放在任务页，不往聊天里推"
          },
          "workspaces": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "工作目录 ID；省略时继承当前会话"
          },
          "mode": {
            "type": "string",
            "enum": [
              "readonly",
              "ask",
              "auto"
            ],
            "description": "不得高于创建者会话的模式"
          },
          "enabled": {
            "type": "boolean"
          },
          "catch_up": {
            "type": "boolean",
            "description": "停机错过一小时内补跑一次，默认 true"
          },
          "timeout": {
            "type": "string",
            "description": "运行超时，默认 30m"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "SendFile",
      "description": "把图片、表情包、动图、音频、视频或文件发到当前聊天，对方直接收到（不是发链接）。files 每项是工作目录里的文件路径（相对路径从工作目录开始），或者 http(s) 网址。想发表情包、图片就用它，别在回复里用文字描述图片。要配一句话就在调用之前或之后照常回复。单个文件最多 20 MB。",
      "parameters": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "要发的文件：路径或网址，按顺序发"
          },
          "workspace": {
            "type": "string",
            "description": "文件在哪个工作目录（挂了好几个时写）"
          }
        },
        "required": [
          "files"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "Session",
      "description": "在会话之间分叉（Fork）：把一个会话在某个安全边界上的上下文保存成不可变快照，分支带着这份上下文独立继续，源会话照常用；分支默认安静运行，结果不发回原来的聊天。action 取 fork / list_branches / inspect / continue / pause / archive。在工具批次里调用 fork 会先返回 pending_boundary，等这批调用结束才真正建好；用同一个 request_id 重试返回同一个分支。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "fork",
              "list_branches",
              "inspect",
              "continue",
              "pause",
              "archive"
            ],
            "description": "要做的事，默认 fork"
          },
          "source_sid": {
            "type": "string",
            "description": "从哪个会话分叉，默认当前会话"
          },
          "branch_sid": {
            "type": "string",
            "description": "inspect / continue / pause / archive 要操作的分支"
          },
          "title": {
            "type": "string",
            "description": "分支标题"
          },
          "prompt": {
            "type": "string",
            "description": "start=true 或 continue 时，这一轮要在分支里做什么"
          },
          "start": {
            "type": "boolean",
            "description": "建完就在分支里开始跑"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "silent"
            ],
            "description": "结果留在分支里；只有用户显式操作可以开启报告"
          },
          "request_id": {
            "type": "string",
            "description": "幂等键：同一个 request_id 重试返回同一个分支"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "echo",
      "description": "回显",
      "parameters": {
        "type": "object"
      }
    }
  }
]
