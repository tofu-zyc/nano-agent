[
  {
    "type": "function",
    "function": {
      "name": "SendFile",
      "description": "把图片、表情包、动图、音频、视频或文件发到当前聊天，对方直接收到（不是发链接）。files 每项是工作目录里的文件路径（相对路径从工作目录开始），或者 http(s) 网址。想发表情包、图片就用它，别在回复里用文字描述图片。要配一句话就在调用之前或之后照常回复。单个文件最多 20 MB。",
      "parameters": {
        "type": "object",
        "properties": {
          "files": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "要发的文件：路径或网址，按顺序发"
          },
          "workspace": {
            "type": "string",
            "description": "文件在哪个工作目录（挂了好几个时写）"
          }
        },
        "required": [
          "files"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "Session",
      "description": "在会话之间分叉（Fork）：把一个会话在某个安全边界上的上下文保存成不可变快照，分支带着这份上下文独立继续，源会话照常用；分支默认安静运行，结果不发回原来的聊天。action 取 fork / list_branches / inspect / continue / pause / archive。在工具批次里调用 fork 会先返回 pending_boundary，等这批调用结束才真正建好；用同一个 request_id 重试返回同一个分支。",
      "parameters": {
        "type": "object",
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "fork",
              "list_branches",
              "inspect",
              "continue",
              "pause",
              "archive"
            ],
            "description": "要做的事，默认 fork"
          },
          "source_sid": {
            "type": "string",
            "description": "从哪个会话分叉，默认当前会话"
          },
          "branch_sid": {
            "type": "string",
            "description": "inspect / continue / pause / archive 要操作的分支"
          },
          "title": {
            "type": "string",
            "description": "分支标题"
          },
          "prompt": {
            "type": "string",
            "description": "start=true 或 continue 时，这一轮要在分支里做什么"
          },
          "start": {
            "type": "boolean",
            "description": "建完就在分支里开始跑"
          },
          "delivery": {
            "type": "string",
            "enum": [
              "silent",
              "attention"
            ],
            "description": "silent（默认）：结果留在分支里；attention：只有分支汇报 ready、blocked、failed 时通知主人，仅主人明确要求时用"
          },
          "request_id": {
            "type": "string",
            "description": "幂等键：同一个 request_id 重试返回同一个分支"
          }
        },
        "required": [
          "action"
        ]
      }
    }
  },
  {
    "type": "function",
    "function": {
      "name": "echo",
      "description": "回显",
      "parameters": {
        "type": "object"
      }
    }
  }
