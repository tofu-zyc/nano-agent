#!/usr/bin/env python3
# 从 stdin 读参数 JSON，取出命令后用 sh 替换当前进程执行：
# 输出直接进内核的管道，退出码原样返回。
import json
import os
import sys

try:
    cmd = json.load(sys.stdin).get("cmd", "")
except (ValueError, AttributeError) as e:
    print(f"参数解析失败：{e}", file=sys.stderr)
    sys.exit(2)
if not isinstance(cmd, str) or not cmd.strip():
    print("缺少 cmd 参数", file=sys.stderr)
    sys.exit(2)
os.execv("/bin/sh", ["sh", "-c", cmd])
